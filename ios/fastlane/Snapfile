# Shared snapshot settings. Devices and iOS versions are set in Fastfile:
# iPhone 17 on 26.5 (Dynamic Island medium, 1206×2622) and iPhone Duo on 27.1
# (outer 1398×2034 when folded). Duo is a separate pass because 26.5 has no Duo.

languages(["en-US"])

scheme("BARTistUITests")
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
override_status_bar(true)
concurrent_simulators(false)
stop_after_first_error(true)
